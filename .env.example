# Variables de entorno del backend en producción (Render). Copia los nombres al panel del servicio;
# los valores reales nunca se guardan en el repositorio. En local se usa backend/config/local.properties.

# Base de datos (Neon). La URL JDBC lleva el host de Neon y sslmode=require.
ALGARROBO_DB_URL=jdbc:postgresql://HOST-DE-NEON/algarrobo?sslmode=require
ALGARROBO_DB_USUARIO=USUARIO_DE_NEON
ALGARROBO_DB_CLAVE=CLAVE_DE_NEON

# Primer administrador del panel: se crea solo si la base aún no tiene usuarios.
# Contraseña nueva, de al menos 12 caracteres, que no hayas usado antes ni compartido.
ALGARROBO_ADMIN_CORREO=tu-correo@ejemplo.com
ALGARROBO_ADMIN_CLAVE=UNA_CONTRASEÑA_LARGA_Y_NUEVA

# Ya vienen en el Dockerfile; solo cámbialas si sabes por qué.
# ALGARROBO_PROXY=native          (lee la IP real y el HTTPS detrás del proxy)
# ALGARROBO_COOKIE_SEGURA=true    (la cookie de sesión solo viaja por HTTPS)
# ALGARROBO_SITIO=/app/sitio/
